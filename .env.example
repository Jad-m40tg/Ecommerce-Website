PORT=5000
JWT_SECRET=change-this-to-a-secure-random-string
CORS_ORIGIN=http://localhost:5000

# Admin seed credentials (used by npm run db:init)
# If not set, a random password is generated and printed to console
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

CHARGILY_SECRET_KEY=your_chargily_secret_key
CHARGILY_PUBLIC_KEY=your_chargily_public_key
CHARGILY_ENV=test
APP_URL=http://localhost:5000

# NOEST delivery API (Algerian courier)
NOEST_API_TOKEN=your_noest_api_token
NOEST_USER_GUID=your_noest_user_guid
ENABLE_NOEST_VALIDATION=false
